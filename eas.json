{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "free" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "free" }
    },
    "preview-premium": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "premium" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_VARIANT": "free" }
    },
    "production-premium": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_VARIANT": "premium" }
    }
  },
  "submit": {
    "production": {}
  }
}
